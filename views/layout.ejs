<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Members Only Club</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <header class="navbar">
        <div class="nav-brand">
            <a href="/">Secret<span>Club</span></a>
        </div>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <% if(!user) {%><li><a href="/auth/login" class="nav-link">Login</a></li><%}%>
                <% if(!user) {%><li><a href="/auth/signup" class="btn btn-primary">Signup</a></li><%}%>
                <% if(user) {%><li><a href="/auth/logout" class="nav-link">Logout</a></li><%}%>
            </ul>
        </nav>
    </header>
    <% if(user) {%>
        <div class="welcome-banner">
            <h3>Welcome back, <%= user.first_name +" "+ user.last_name %>!</h3>
        </div>
    <%}%>
    <main class="container">
        <%- body -%>
    </main>
    <footer>
        <p>Tayyab Gull &copy; 2026</p>
    </footer>
</body>

</html>