<h1>Join Club by entering a secret key</h1>
<% if (error) { %>
    <p style="color: red;"><%= error %></p>
<% } %>
<form action="/membership/join" method="post">
    <label for="secret-key">Secret Key:</label>
    <input type="text" id="secret-key" name="secret-key" required />
    <br />
    <button type="submit">Join Club</button>
</form>